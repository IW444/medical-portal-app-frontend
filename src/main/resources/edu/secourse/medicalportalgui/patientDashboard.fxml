<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.secourse.medicalportalgui.controller.PatientDashboardController"
            prefWidth="900" prefHeight="650" style="-fx-background-color: #f4f7f9;">

    <top>
        <VBox spacing="5" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Patient Portal" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="welcomeLabel" text="Welcome back, Patient" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                </VBox>

                <Button text="Change Password" onAction="#handleChangePassword"
                        style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-text-fill: #7f8c8d; -fx-border-radius: 5; -fx-cursor: hand;"/>

                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Your Appointments" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Refresh List" onAction="#handleRefreshAppointments"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>

            <TableView fx:id="appointmentsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 5; -fx-border-radius: 5;">
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="colStartTime" text="Start Time" prefWidth="100"/>
                    <TableColumn fx:id="colEndTime" text="End Time" prefWidth="100"/>
                    <TableColumn fx:id="colDoctor" text="Doctor" prefWidth="250"/>
                    <TableColumn fx:id="colLastUpdated" text="Last Updated" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Cancel Selected Appointment" onAction="#handleCancelAppointment"
                        style="-fx-background-color: white; -fx-border-color: #e74c3c; -fx-text-fill: #e74c3c; -fx-border-radius: 3; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
