<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.secourse.medicalportalgui.controller.DoctorDashboardController"
            prefWidth="950" prefHeight="700" style="-fx-background-color: #f8fafc;">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 15 30 15 30;">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Medical Practice Management" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Label fx:id="welcomeLabel" text="Welcome, Dr. [Name]" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </VBox>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-border-color: #ecf0f1; -fx-text-fill: white; -fx-border-radius: 5; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                <Label text="View Schedule:" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                <ToggleButton text="Today" selected="true">
                    <toggleGroup><ToggleGroup fx:id="filterGroup"/></toggleGroup>
                </ToggleButton>
                <ToggleButton text="This Week" toggleGroup="$filterGroup"/>
                <ToggleButton text="This Month" toggleGroup="$filterGroup"/>

                <Region HBox.hgrow="ALWAYS" />

                <Button text="Refresh" onAction="#handleRefreshAppointments"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <VBox VBox.vgrow="ALWAYS" spacing="10">
                <Label text="Upcoming Appointments" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <TableView fx:id="appointmentsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                        <TableColumn fx:id="colStartTime" text="Start Time" prefWidth="100"/>
                        <TableColumn fx:id="colEndTime" text="End Time" prefWidth="100"/>
                        <TableColumn fx:id="colPatient" text="Patient Name" prefWidth="250"/>
                        <TableColumn fx:id="colLastUpdated" text="Last Updated" prefWidth="180"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Button text="Change Password" onAction="#handleChangePassword"
                        style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
